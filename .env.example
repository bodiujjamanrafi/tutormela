VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Gmail SMTP. Never prefix these names with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=Tutormela <your-sender@gmail.com>
OTP_HMAC_SECRET=GENERATE_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Firebase browser configuration is public by design. Never add an admin/private key here.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=tutormela.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tutormela
VITE_FIREBASE_STORAGE_BUCKET=tutormela.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
